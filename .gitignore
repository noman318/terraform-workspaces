# Local .terraform directories
.terraform/

# State files (contain resource details and possibly secrets)
*.tfstate
*.tfstate.*
terraform.tfstate.d/

# Crash logs
crash.log
crash.*.log

# Variable files (environment-specific values) - keep the example
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc

# Plan output files
*.tfplan
